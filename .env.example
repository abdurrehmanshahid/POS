# ┌──────────────────────────────────────────────────────────────────────────┐
# │ THIS FILE IS CONFIGURED FOR LOCAL DEVELOPMENT.                           │
# │                                                                          │
# │ Going to production? Read docs/DEPLOYMENT.md first, then change at least │
# │ these four before the site is reachable:                                 │
# │                                                                          │
# │   APP_ENV=production          APP_DEBUG=false                            │
# │   SESSION_SECURE_COOKIE=true  INSTITUTE_TODAY=      (leave blank)        │
# │                                                                          │
# │ APP_DEBUG=true on a public host prints stack traces, environment values  │
# │ and database credentials to anyone who triggers an error.                │
# └──────────────────────────────────────────────────────────────────────────┘

APP_NAME="Big Binary Tech Institute"
# local | production. MUST be production on a live host: the demo login buttons
# and their server-side shortcuts are gated on this value being 'local'.
APP_ENV=local
APP_KEY=
# MUST be false in production. See the banner above.
APP_DEBUG=true
# On a live host this must be the real https:// address staff use: the
# password-reset link emailed out is built from it rather than from the
# hostname the caller claims, so an attacker cannot aim a real reset token at
# their own server.
APP_URL=http://localhost

# Whose X-Forwarded-Proto / -For / -Port to believe. `*` suits a platform whose
# edge is the only way in (Vercel); pin the proxy's own address anywhere the app
# can also be reached directly. Full rationale in config/app.php; the nginx
# gotcha that costs you the per-IP login brake is in docs/DEPLOYMENT.md.
#
#   TRUSTED_PROXIES=127.0.0.1
#   TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Cost of the bcrypt work factor. 12 is a good 2026 default; raise it only if
# your host's CPU can take it, every sign-in pays this cost.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database. MySQL 8 / MariaDB 10.6+ (cPanel shared hosting target)
# -----------------------------------------------------------------------------
# On cPanel the database and user are created in "MySQL® Databases" and are
# automatically prefixed with your account name, e.g. bbtedu_pos / bbtedu_posuser.
# Use sqlite only for throwaway local dev; never for real money data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bbt_pos
DB_USERNAME=bbt_pos
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session security
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
# 120 minutes of inactivity. Shorter is safer on shared front-desk machines.
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
# Encrypt session payloads at rest. On shared hosting other accounts may be one
# misconfiguration away from your storage directory, and sessions hold the
# identity of whoever is signed in. Cheap insurance, leave this on.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over HTTPS only. MUST be true in production; set it
# false only for plain-HTTP local development or you will not be able to log in.
SESSION_SECURE_COOKIE=false
# Blocks the cookie from JavaScript (defence in depth against XSS session theft).
SESSION_HTTP_ONLY=true
# 'lax' lets normal navigation carry the cookie but blocks it on cross-site
# POSTs, which is a second line of defence behind Laravel's CSRF tokens.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail, only needed if you turn on self-service password reset (see below)
# -----------------------------------------------------------------------------
# Free options that work on cPanel:
#   * Gmail / Workspace app password:  smtp.gmail.com : 587 : tls
#   * Brevo free tier (300/day):       smtp-relay.brevo.com : 587
#   * cPanel's own mail server:        localhost : 25 or 465
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bbt.edu.pk"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Institute configuration
# -----------------------------------------------------------------------------
# Pins "today" so the demo reproduces the prototype's exact figures
# (billed 214,000 = received 119,000 + outstanding 95,000).
# LEAVE THIS BLANK IN PRODUCTION so overdue dates use the real current date.
INSTITUTE_TODAY=

# Self-service password reset by emailed link. Keep FALSE until MAIL_* above
# actually sends, with no way to prove someone owns an address, a reset form is
# just an account-takeover form. While false, administrators issue one-time
# temporary passwords from the Staff screen instead.
INSTITUTE_SELF_SERVICE_RESET=false

# Label shown next to the account in Google Authenticator / Authy / 1Password.
INSTITUTE_TOTP_ISSUER="Big Binary Tech"

# -----------------------------------------------------------------------------
# Super admin (platform owner), used only by `db:seed` on a fresh install
# -----------------------------------------------------------------------------
# Leave SUPERADMIN_PASSWORD blank and the seeder generates a strong random one
# and prints it to the console ONCE. Two-factor enrolment is forced on first
# sign-in at /superadmin regardless.
SUPERADMIN_NAME="Platform Owner"
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=owner@bbt.edu.pk
SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
