# Vercel bundles the whole repository into the function unless told otherwise,
# and function size affects cold-start time on every request.

/tests
/.github
/docs
/.phpunit.result.cache
/database/database.sqlite

# Real student data and issued invoices. These are already gitignored; listed
# again so a local deploy from a dirty working tree cannot ship them either.
/student_details_report*.xlsx
/Invoice *.pdf

# Built during the deployment, never uploaded.
/node_modules
