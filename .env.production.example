# ┌──────────────────────────────────────────────────────────────────────────┐
# │ PRODUCTION TEMPLATE — AWS Lightsail, Ubuntu 24.04, MySQL 8.0             │
# │                                                                          │
# │ Copy to .env ON THE SERVER and fill in the four values marked FILL IN.   │
# │ Do NOT copy .env.example for production: it is a LOCAL template and its  │
# │ defaults (APP_ENV=local, APP_DEBUG=true, SESSION_SECURE_COOKIE=false,    │
# │ BACKUP_KEEP=14) are each individually unsafe on a live host.             │
# │                                                                          │
# │ Every value below marked REQUIRED is asserted by deploy.sh in preflight  │
# │ and by `php artisan deploy:preflight`. The deploy REFUSES rather than    │
# │ warns. See docs/DEPLOYMENT.md §4.1 for what each one prevents.           │
# │                                                                          │
# │ This file contains no secrets and never should. Real values live on the  │
# │ server and in the off-box secret store (docs/PRODUCTION-EMERGENCY.md).   │
# └──────────────────────────────────────────────────────────────────────────┘

APP_NAME="Big Binary Tech Institute"

# REQUIRED: production. 'local' exposes the passwordless demo login buttons and
# their server-side shortcuts — they are gated on this exact value.
APP_ENV=production

# REQUIRED, FILL IN: generate ONCE on the server with `php artisan key:generate`
# and store it off-box IMMEDIATELY, before anything else happens.
#
# This key decrypts every stored TOTP secret. A database restored without it
# locks out every enrolled account, /superadmin included, and there is no way
# back in through the application. A dump alone is not a backup; a dump plus
# this key is. NEVER rotate it after go-live.
APP_KEY=

# REQUIRED: false. True prints the fully resolved configuration — DB_PASSWORD
# included — on any error page, to whoever triggered the error.
APP_DEBUG=false

# REQUIRED, FILL IN: the real https address staff use.
# The password-reset link is built from this rather than from the Host header
# the caller claims, which is what stops an attacker aiming a genuine, unexpired
# reset token at their own server.
APP_URL=https://pos.bbt.edu.pk

# REQUIRED: not '*'. nginx runs on this box, so pin it to loopback.
# '*' believes whoever is speaking, so a forged X-Forwarded-For rotates around
# the per-IP login brake. It is correct only where the platform edge is the sole
# way in; this instance is directly reachable on its static IP.
#
# Note this is also unsafe by OMISSION: config/app.php defaults it to '*', so a
# missing line here is not "unset", it is "trust everyone". deploy.sh checks for
# absence specifically.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Not debug. Debug-level logging on a live box fills the disk and buries the
# lines that matter, and a full disk looks like a hundred unrelated bugs.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — MySQL 8.0 on this box
# -----------------------------------------------------------------------------
# REQUIRED: mysql. The framework default is sqlite, so a missing line here runs
# the counter on a file that nothing backs up and nothing dumps.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=institute_pos
DB_USERNAME=institute_pos
# FILL IN: printed once by provision.sh, and kept at /root/.institute-db-password
DB_PASSWORD=

# REQUIRED: +00:00.
# TIMESTAMP columns are converted by the server's session timezone and DATETIME
# columns are not. Let those disagree and a payment taken near midnight is filed
# on the wrong day — which is the wrong month's revenue, twelve times a year.
# Storage is UTC everywhere by design; the display layer localises to Lahore.
DB_TIMEZONE=+00:00

# -----------------------------------------------------------------------------
# Session, cache and queue — all on the database driver
# -----------------------------------------------------------------------------
# There is no Redis on this box and none is coming in release one.
#
# SESSION_DRIVER=database is not a preference: on the file driver a deploy logs
# out every signed-in officer mid-transaction.
#
# CACHE_STORE=database is not cosmetic either — the scheduler's
# withoutOverlapping lock for the hourly backup lives in the cache store. On the
# 'array' driver that lock does not exist between processes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# REQUIRED: true — but MIND THE ORDER.
#
# A secure cookie is never sent over plain HTTP, so setting this true before TLS
# exists means nobody can log in, including you, to fix it. The bootstrap order
# in docs/DEPLOYMENT.md §6 is:
#
#   1. first deploy with SESSION_SECURE_COOKIE=false
#   2. certbot --nginx -d <domain>
#   3. set this to true
#   4. deploy again
#
# deploy.sh asserts `true`, which is correct for every pipeline deploy: those
# only ever happen after TLS is up.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail — off until it actually sends
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bbt.edu.pk"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Institute
# -----------------------------------------------------------------------------
# REQUIRED BLANK. This pins the application's idea of "today". Set, every
# overdue date and every this-month figure freezes on it — quietly, and looking
# entirely correct. It exists so the demo reproduces the prototype's exact
# numbers. The local .env currently pins 2026-07-15; that value must never reach
# a live host.
INSTITUTE_TODAY=

# Stamped on every student code, admission number and challan number.
#
# DECIDE THIS ONCE, BEFORE THE FIRST VOUCHER IS ISSUED. Changing it after
# go-live does not rewrite identifiers already printed on documents a parent is
# holding; new records simply carry the new prefix and the series is
# permanently inconsistent. This is an institute decision, not an engineering
# one.
INSTITUTE_CODE_PREFIX=BBT-

# The wall clock the scheduler reads, and the one receipts are displayed in.
# Storage stays UTC — do NOT set the server's system clock to this.
INSTITUTE_TIMEZONE=Asia/Karachi

# Keep FALSE until MAIL_* above actually sends. With no way to prove someone
# owns an address, a reset form is an account-takeover form. Until then,
# administrators issue one-time temporary passwords from the Staff screen.
INSTITUTE_SELF_SERVICE_RESET=false

INSTITUTE_TOTP_ISSUER="Big Binary Tech"
INSTITUTE_CONTACT_EMAIL=accounts@bbt.edu.pk
# Printed in the fee voucher footer. Deliberately has no default: a blank one is
# omitted from the voucher, which is honest; a placeholder that looks like a
# real Lahore landline is not, and a parent chasing a missing fee would dial it.
INSTITUTE_CONTACT_PHONE=

# -----------------------------------------------------------------------------
# Backups — HOURLY
# -----------------------------------------------------------------------------
# REQUIRED. provision.sh creates and chowns this. The application's own default
# is storage/app/backups, which sits inside the tree deploy.sh git-resets and
# chmods, is not what the off-box copy job reads, and is not where any operator
# instruction says to look. deploy.sh refuses to run without this line.
BACKUP_PATH=/var/backups/institute

# REQUIRED: 168, and this is the one people get wrong.
#
# BACKUP_KEEP is a COUNT, not an age. At the old nightly schedule, 14 meant a
# fortnight. Backups are now HOURLY, so 14 means FOURTEEN HOURS — and nothing
# would say so: backup:run still succeeds, the weekly restore drill still
# passes, the directory still looks full, and yesterday has quietly gone.
#
# 168 = 24 x 7, seven days of hourly dumps. They are small. Longer retention
# belongs off-box, below, which is where it should live anyway.
BACKUP_KEEP=168

# FILL IN: the rclone remote that holds the off-box copy, e.g.
# r2:institute-backups (Cloudflare R2 — 10GB free, no egress fees, and lifecycle
# rules are a bucket setting).
#
# This is the line between a backup and a disaster-recovery plan: everything
# above writes to the same disk the database is on, and dies with that disk.
#
# backup:run copies here after a SUCCESSFUL dump only, with `--max-age 2h`.
# On-box dumps are never deleted because the remote copy worked — the two
# retentions are independent (7 days on-box, 30 days off, enforced by a bucket
# lifecycle rule, not by rclone).
#
# Configure as the app account so the scheduler can read it:
#   sudo -u institute rclone config
# The resulting ~institute/.config/rclone/rclone.conf must be mode 0600 and a
# copy belongs in the off-box secret store. Leave this blank and every hourly
# run logs a warning — deliberately loud, because a box with no off-box copy has
# backups and no disaster recovery.
BACKUP_RCLONE_REMOTE=

# The kernel lock shared by the hourly dump, the pre-deploy dump and a human at
# a prompt. provision.sh creates this path via /etc/tmpfiles.d/institute.conf.
BACKUP_LOCK_PATH=/run/institute-backup.lock

# Throwaway database the weekly restore drill restores INTO, then drops. It must
# differ from the live database, and provision.sh grants the app user rights on
# this exact name — change one and you must change the other.
BACKUP_VERIFY_DATABASE=institute_restore_check

# -----------------------------------------------------------------------------
# Super admin — read ONLY by `db:seed --class=SuperAdminSeeder` on a fresh box
# -----------------------------------------------------------------------------
# REQUIRED BLANK in production. Blank means the seeder generates a strong random
# password and prints it to the console ONCE. Record it off-box immediately.
# Two-factor enrolment is forced on first sign-in at /superadmin regardless.
SUPERADMIN_NAME="Platform Owner"
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=owner@bbt.edu.pk
SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
