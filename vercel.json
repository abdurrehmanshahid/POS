{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/vendor/(.*)", "dest": "/public/vendor/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "build": {
    "env": {
      "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
      "DOMPDF_FONT_DIR": "/tmp/storage/fonts"
    }
  },
  "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm ci && npm run build && php artisan config:cache && php artisan route:cache",
  "outputDirectory": "."
}
